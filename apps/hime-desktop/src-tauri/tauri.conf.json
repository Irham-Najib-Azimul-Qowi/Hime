{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hime",
  "version": "1.0.0",
  "identifier": "com.hime.assistant",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hime Assistant",
        "width": 980,
        "height": 700,
        "minWidth": 440,
        "minHeight": 88,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Personal AI Desktop Environment for Windows",
    "longDescription": "Hime integrates a floating Dynamic Island interface with an autonomous AI agent runtime, memory, storage intelligence, and developer workspaces.",
    "copyright": "Copyright 2026 Hime Contributors",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
