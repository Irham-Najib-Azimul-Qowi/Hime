{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hime",
  "version": "1.0.0",
  "identifier": "com.hime.assistant",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hime Dynamic Island",
        "width": 640,
        "height": 220,
        "minWidth": 460,
        "minHeight": 44,
        "x": 0,
        "y": 0,
        "center": false,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Personal AI Desktop Environment for Windows",
    "longDescription": "Hime integrates a floating Dynamic Island interface with an autonomous AI agent runtime, memory, storage intelligence, and developer workspaces.",
    "copyright": "Copyright 2026 Hime Contributors",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
