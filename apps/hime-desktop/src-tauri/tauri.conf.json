{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hime",
  "version": "0.1.0",
  "identifier": "com.hime.assistant",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hime Assistant",
        "width": 980,
        "height": 700,
        "minWidth": 440,
        "minHeight": 88,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}

