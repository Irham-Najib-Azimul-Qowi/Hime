# =============================================================================
# Hime Assistant — Local Development Environment Variables (.env.example)
# Copy this file to .env.local for local overrides. NEVER commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment & Runtime Mode
# -----------------------------------------------------------------------------
HIME_ENV=development
HIME_LOG_LEVEL=debug
HIME_LOG_FORMAT=jsonl

# -----------------------------------------------------------------------------
# 2. Local Storage & Directory Layout
# Windows default: %LOCALAPPDATA%\Hime\dev
# Linux default:   $XDG_DATA_HOME/hime/dev or ~/.local/share/hime/dev
# -----------------------------------------------------------------------------
HIME_DATA_DIR=
HIME_CONFIG_DIR=
HIME_LOGS_DIR=
HIME_STATE_DIR=

# -----------------------------------------------------------------------------
# 3. Inter-Process Communication (IPC) Configuration
# Windows: Named Pipe path
# Linux:   Unix Domain Socket path
# -----------------------------------------------------------------------------
HIME_IPC_PIPE_WINDOWS=\\.\pipe\hime-hermes-dev
HIME_IPC_SOCKET_LINUX=hime/dev.sock
HIME_IPC_AUTH_TIMEOUT_MS=2000

# -----------------------------------------------------------------------------
# 4. 9Router AI Gateway Configuration (Localhost Only)
# -----------------------------------------------------------------------------
HIME_ROUTER_HOST=127.0.0.1
HIME_ROUTER_PORT=20128
HIME_ROUTER_DATA_DIR=
# In development, use a local random token placeholder; DO NOT use production keys
HIME_ROUTER_MASTER_KEY=sk-hime-dev-dummy-key-placeholder-0000000000000000

# -----------------------------------------------------------------------------
# 5. Hermes Agent Runtime Integration
# -----------------------------------------------------------------------------
HERMES_PYTHON_BIN=python
HERMES_VENV_PATH=
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
# Dummy key placeholder for local loopback; commercial keys MUST use DPAPI Vault
OPENAI_API_KEY=hime-managed-key

# -----------------------------------------------------------------------------
# 6. Safety & Resource Budgets
# -----------------------------------------------------------------------------
HIME_MAX_ACTIVE_TASKS=1
HIME_ACTION_APPROVAL_TIMEOUT_MS=30000
HIME_ACTION_APPROVAL_MIN_DELAY_MS=500
HIME_STORAGE_RETENTION_DAYS=30
HIME_MAX_PAYLOAD_SIZE_BYTES=16777216

