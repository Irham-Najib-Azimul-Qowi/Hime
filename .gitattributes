# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Windows shell scripts require CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.wasm binary
*.exe binary
*.dll binary
*.lock binary
