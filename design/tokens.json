{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Hime Island Design Tokens",
  "version": "1.0.0",
  "surfaces": {
    "surface-island": "#000000",
    "surface-1": "#0D0E12",
    "surface-2": "#14161C",
    "surface-3": "#1B1E26",
    "line": "#262A34"
  },
  "text": {
    "text-1": { "value": "#F4F6FA", "contrastOnSurface2": 16.7 },
    "text-2": { "value": "#A7AEBB", "contrastOnSurface2": 8.1 },
    "text-3": { "value": "#6F7785", "contrastOnSurface2": 4.0 }
  },
  "accents": {
    "mint":   { "value": "#34E3A6", "darkTextContrast": 11.9, "tintTextContrast": 7.4, "role": "primary, success" },
    "cyan":   { "value": "#38D6F5", "darkTextContrast": 11.3, "tintTextContrast": 7.1, "role": "info, eyes default" },
    "sky":    { "value": "#5AA9FF", "darkTextContrast": 8.0,  "tintTextContrast": 5.4, "role": "category" },
    "violet": { "value": "#A18BFF", "darkTextContrast": 7.2,  "tintTextContrast": 5.0, "role": "category, agent thinking" },
    "pink":   { "value": "#FF5C93", "darkTextContrast": 6.8,  "tintTextContrast": 4.8, "role": "category, important" },
    "coral":  { "value": "#FF7A59", "darkTextContrast": 7.7,  "tintTextContrast": 5.3, "role": "soft warning" },
    "amber":  { "value": "#FFC247", "darkTextContrast": 12.2, "tintTextContrast": 7.5, "role": "due soon, attention" },
    "lime":   { "value": "#A8EE4B", "darkTextContrast": 14.1, "tintTextContrast": 8.3, "role": "progress, streak, focus" },
    "red":    { "value": "#FF4D5E", "darkTextContrast": 6.1,  "tintTextContrast": 4.5, "role": "danger, late" }
  },
  "geometry": {
    "spacing": [4, 8, 12, 16, 24],
    "radius": {
      "pill": 9999,
      "card": 14,
      "iconTile": 10,
      "input": 12
    },
    "rowHeight": 44,
    "iconSize": {
      "inline": 16,
      "row": 20,
      "button": 24
    },
    "progressBarHeight": 6,
    "progressRingWidth": 4,
    "borderWidth": 1
  },
  "typography": {
    "title": { "size": 14, "weight": 600, "lineHeight": 20 },
    "body":  { "size": 13, "weight": 500, "lineHeight": 18 },
    "desc":  { "size": 12, "weight": 400, "lineHeight": 16 }
  },
  "motion": {
    "snappy": { "stiffness": 520, "damping": 38, "mass": 1 },
    "smooth": { "stiffness": 320, "damping": 30, "mass": 1 },
    "soft":   { "stiffness": 200, "damping": 26, "mass": 1 },
    "bouncy": { "stiffness": 380, "damping": 18, "mass": 1 }
  }
}
