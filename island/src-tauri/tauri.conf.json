{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Hime Island",
	"version": "3.10.2",
	"identifier": "local.hime.island",
	"build": {
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Hime Island",
				"width": 1920,
				"height": 1080,
				"x": 0,
				"y": 0,
				"decorations": false,
				"transparent": true,
				"resizable": false,
				"maximizable": false,
				"minimizable": false,
				"closable": false,
				"alwaysOnTop": true,
				"visibleOnAllWorkspaces": true,
				"focus": false,
				"skipTaskbar": true,
				"shadow": false,
				"visible": true,
				"dragDropEnabled": true
			},
			{
				"label": "settings",
				"create": false,
				"title": "Settings",
				"url": "settings.html",
				"width": 740,
				"height": 560,
				"decorations": false,
				"transparent": true,
				"resizable": true,
				"maximizable": false,
				"minimizable": false,
				"closable": false,
				"alwaysOnTop": false,
				"visibleOnAllWorkspaces": false,
				"focus": true,
				"skipTaskbar": false,
				"shadow": true,
				"visible": false,
				"center": true
			},
			{
				"label": "overlay",
				"title": "Overlay",
				"url": "overlay.html",
				"width": 1920,
				"height": 1080,
				"x": 0,
				"y": 0,
				"decorations": false,
				"transparent": true,
				"resizable": false,
				"maximizable": false,
				"minimizable": false,
				"closable": false,
				"alwaysOnTop": true,
				"visibleOnAllWorkspaces": true,
				"focus": false,
				"skipTaskbar": true,
				"shadow": false,
				"visible": false
			},
			{
				"label": "dock",
				"title": "Hime Dock",
				"url": "dock.html",
				"width": 1920,
				"height": 600,
				"x": 0,
				"y": 480,
				"decorations": false,
				"transparent": true,
				"resizable": false,
				"maximizable": false,
				"minimizable": false,
				"closable": false,
				"alwaysOnTop": true,
				"visibleOnAllWorkspaces": true,
				"focus": false,
				"skipTaskbar": true,
				"shadow": false,
				"visible": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"publisher": "Hime Project",
		"copyright": "Copyright © 2026 Hime Project Contributors",
		"category": "Utility",
		"shortDescription": "Personal AI Dynamic Island and Dock for Windows",
		"longDescription": "Hime Island provides a personal AI Dynamic Island interface and dock for Windows.",
		"windows": {
			"webviewInstallMode": {
				"type": "embedBootstrapper"
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"active": false,
			"endpoints": [],
			"pubkey": ""
		}
	}
}
